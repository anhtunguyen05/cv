      "request": {"method": "POST", "path": "/api/v1/auth/login", "headers": {"X-CSRF-TOKEN": "<synthetic-csrf-token>"}, "body": {"email": "existing@example.test", "password": "<synthetic-password>"}},
      "expect": {"status": 200, "body": {"data": {"user": "public_user"}}, "headers": {"cache_control": "private, no-store"}, "session": {"regenerated": true, "authenticated": true}, "client_action": "store_public_user_and_navigate_dashboard", "forbidden_response_fields": "global"}
    },
