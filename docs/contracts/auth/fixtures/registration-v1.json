      "expect": {"status": 419, "error": {"code": "SESSION_EXPIRED"}, "client_action": "refresh_csrf_once_then_show_recoverable_error", "creates_user": false}
    },
    {
      "id": "register-response-lost",
      "ac": ["AC-1-1-register-an-account-01", "AC-1-1-register-an-account-02"],
      "operation": "register",
      "precondition": "persistence_may_have_committed_but_response_is_lost",
      "request": {"method": "POST", "path": "/api/v1/auth/register", "body": "valid_registration_body"},
      "expect": {"client_action": "call_current_account_before_explicit_retry", "if_current_account_200": {"action": "navigate_dashboard"}, "if_current_account_401": {"action": "permit_one_explicit_retry"}, "automatic_retry": false}
    },
    {
