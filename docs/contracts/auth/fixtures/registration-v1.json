      "request": {"method": "POST", "path": "/api/v1/auth/login", "headers": {"X-CSRF-TOKEN": "<synthetic-csrf-token>"}, "body": {"email": "unknown@example.test", "password": "<synthetic-password>"}},
      "expect": {"status": 401, "error": {"code": "INVALID_CREDENTIALS", "message": "generic_invalid_credentials", "shape": "login-invalid-credential"}, "client_action": "show_generic_login_error", "authenticated": false, "user_disclosure": false}
    },
