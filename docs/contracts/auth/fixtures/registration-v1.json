      "operation": "login",
      "precondition": "guest_with_valid_csrf_session_and_existing_email",
      "request": {"method": "POST", "path": "/api/v1/auth/login", "headers": {"X-CSRF-TOKEN": "<synthetic-csrf-token>"}, "body": {"email": "existing@example.test", "password": "<wrong-synthetic-password>"}},
      "expect": {"status": 401, "error": {"code": "INVALID_CREDENTIALS", "message": "generic_invalid_credentials", "shape": "login-invalid-credential"}, "same_public_failure_as": "login-unknown-email", "client_action": "show_generic_login_error", "authenticated": false, "user_disclosure": false}
    },
