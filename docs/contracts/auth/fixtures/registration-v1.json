      "operation": "logout",
      "precondition": "guest_or_already_invalidated_session_with_valid_csrf",
      "request": {"method": "POST", "path": "/api/v1/auth/logout", "headers": {"X-CSRF-TOKEN": "<synthetic-csrf-token>"}, "body": {}},
      "expect": {"status": 204, "body": null, "idempotent": true, "client_action": "clear_auth_and_protected_cache_and_navigate_login", "user_data": "unchanged"}
    },
    {
      "id": "logout-invalid-csrf",
      "ac": ["AC-1-2-sign-in-and-sign-out-04", "AC-1-2-sign-in-and-sign-out-05"],
      "references": ["E1-DEC-001", "E1-DEC-009"],
      "operation": "logout",
      "precondition": "authenticated_session_with_invalid_or_expired_csrf",
      "request": {"method": "POST", "path": "/api/v1/auth/logout", "body": {}},
      "expect": {"status": 419, "error": {"code": "SESSION_EXPIRED"}, "client_action": "clear_protected_state_and_redirect_login", "user_data": "unchanged"}
