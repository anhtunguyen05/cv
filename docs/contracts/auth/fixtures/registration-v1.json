      "request": {"method": "POST", "path": "/api/v1/auth/logout", "headers": {"X-CSRF-TOKEN": "<synthetic-csrf-token>"}, "body": {}},
      "expect": {"status": 204, "body": null, "session": {"invalidated": true, "csrf_regenerated": true}, "client_action": "clear_auth_and_protected_cache_and_navigate_login", "user_data": "unchanged", "protected_requests_after_logout": "rejected"}
    },
