{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "careerfit://contracts/ai/patch-proposal-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "execution_id", "request_hash", "source", "context", "constraints"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "execution_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["cv_version_id", "snapshot_hash"], "properties": {"cv_version_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}, "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["source_fragment", "positive_evidence"], "properties": {"source_fragment": {"type": "object", "additionalProperties": false, "required": ["kind", "current_value"], "properties": {"kind": {"const": "summary"}, "current_value": {"type": ["string", "null"], "maxLength": 2000}}}, "positive_evidence": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["id", "area_signal_id", "answer"], "properties": {"id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}, "area_signal_id": {"type": "string", "minLength": 1, "maxLength": 120}, "answer": {"type": "string", "minLength": 1, "maxLength": 2000}}}}}},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["target_allowlist", "locale"], "properties": {"target_allowlist": {"const": ["summary"]}, "locale": {"const": "en"}}}
  }
}
