{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "careerfit://contracts/ai/patch-proposal-response-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "execution_id", "request_hash", "source", "status", "candidate", "metadata"],
  "properties": {
    "contract_version": {"const": "1.0"}, "execution_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}, "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["cv_version_id", "snapshot_hash"], "properties": {"cv_version_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}, "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "status": {"const": "succeeded"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["target", "proposed_text", "reason", "evidence_source_ids"], "properties": {"target": {"type": "object", "additionalProperties": false, "required": ["section", "field", "item_id", "operation"], "properties": {"section": {"const": "summary"}, "field": {"const": "summary"}, "item_id": {"type": "null"}, "operation": {"const": "replace"}}}, "proposed_text": {"type": "string", "minLength": 1, "maxLength": 2000}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_source_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}}}},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "prompt_version", "input_tokens", "output_tokens", "latency_ms"], "properties": {"provider": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"}, "model": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"}, "prompt_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"}, "input_tokens": {"type": "integer", "minimum": 0, "maximum": 100000}, "output_tokens": {"type": "integer", "minimum": 0, "maximum": 100000}, "latency_ms": {"type": "integer", "minimum": 0, "maximum": 120000}}}
  }
}
